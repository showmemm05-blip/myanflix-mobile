# Copy to .env before running the app.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (Expo's
# public-env convention) — never put secrets here.
#
# "localhost" means a different machine depending on where the app runs:
#   - iOS Simulator:      http://localhost:3001/api          (shares the Mac's network stack)
#   - Android Emulator:   http://10.0.2.2:3001/api            (10.0.2.2 is the emulator's alias for the host machine)
#   - Physical device:    http://<your-machine's-LAN-IP>:3001/api  (must be on the same Wi-Fi network as the backend)
# Currently set for the Android emulator (10.0.2.2 is its alias for this Mac,
# so it survives LAN IP changes). For a physical device, swap to the Mac's
# current LAN IP: http://192.168.100.168:3001/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api
